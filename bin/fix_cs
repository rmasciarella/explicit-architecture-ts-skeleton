#!/usr/bin/env node

/**
 * Lint fix script - Runs ESLint and Prettier to fix code style
 *
 * Usage: ./bin/fix_cs or npm run lint:fix
 */

const { execSync } = require('child_process');
const path = require('path');

const rootDir = path.resolve(__dirname, '..');
const env = process.env.ENV || 'dev';
const args = process.argv.slice(2).join(' ');

function fixCs() {
    // If --dry-run is passed, just check instead of fixing
    const isDryRun = args.includes('--dry-run');
    const command = isDryRun ? 'npm run lint && npm run format:check' : 'npm run lint:fix && npm run format';

    switch (env) {
        case 'dev':
            try {
                execSync(
                    `docker-compose -f ${rootDir}/build/container/${env}/docker-compose.yml run --no-deps --rm app ${command}`,
                    { stdio: 'inherit' }
                );
            } catch (error) {
                process.exit(error.status || 1);
            }
            break;
        default:
            try {
                execSync(command, { stdio: 'inherit' });
            } catch (error) {
                process.exit(error.status || 1);
            }
    }
}

fixCs();
