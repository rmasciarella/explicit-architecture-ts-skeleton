#!/usr/bin/env node

/**
 * Run script - Starts the application
 *
 * Usage: ./bin/run or npm run run
 */

const { execSync } = require('child_process');
const path = require('path');

const rootDir = path.resolve(__dirname, '..');
const env = process.env.ENV || 'dev';

function run() {
    let command;

    switch (env) {
        case 'dev':
            command = `docker-compose -f ${rootDir}/build/container/${env}/docker-compose.yml run app npm run run`;
            break;
        default:
            command = `docker-compose -f ${rootDir}/build/container/prd/docker-compose.yml run app npm run run`;
    }

    try {
        execSync(command, { stdio: 'inherit' });
    } catch (error) {
        process.exit(error.status || 1);
    }
}

run();
