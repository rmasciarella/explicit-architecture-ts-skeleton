#!/usr/bin/env node

/**
 * Coverage script - Runs tests with code coverage
 *
 * Usage: ./bin/coverage or npm run test:coverage
 */

const { execSync } = require('child_process');
const path = require('path');

const rootDir = path.resolve(__dirname, '..');
const env = process.env.ENV || 'dev';

function coverage() {
    const command = 'npm run test:coverage';

    switch (env) {
        case 'ci':
            try {
                execSync(
                    `docker-compose -f ${rootDir}/build/container/${env}/docker-compose.yml run app ${command}`,
                    { stdio: 'inherit' }
                );
            } finally {
                execSync(
                    `docker-compose -f ${rootDir}/build/container/${env}/docker-compose.yml down`,
                    { stdio: 'inherit' }
                );
            }
            break;
        case 'dev':
            try {
                execSync(
                    `docker-compose -f ${rootDir}/build/container/${env}/docker-compose.yml run app ${command}`,
                    { stdio: 'inherit' }
                );
            } finally {
                execSync(
                    `docker-compose -f ${rootDir}/build/container/${env}/docker-compose.yml down`,
                    { stdio: 'inherit' }
                );
            }
            break;
        default:
            execSync(command, { stdio: 'inherit' });
    }
}

try {
    coverage();
} catch (error) {
    process.exit(error.status || 1);
}
