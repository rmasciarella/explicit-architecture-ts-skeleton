#!/usr/bin/env node

/**
 * Test script - Runs the test suite
 *
 * Usage: ./bin/test or npm run test
 */

const { execSync } = require('child_process');
const path = require('path');

const rootDir = path.resolve(__dirname, '..');
const env = process.env.ENV || 'dev';
const args = process.argv.slice(2).join(' ');

function test() {
    const command = `npm run test ${args}`;

    switch (env) {
        case 'ci':
        case 'dev':
            try {
                execSync(
                    `docker-compose -f ${rootDir}/build/container/${env}/docker-compose.yml run app ${command}`,
                    { stdio: 'inherit' }
                );
            } finally {
                execSync(
                    `docker-compose -f ${rootDir}/build/container/${env}/docker-compose.yml down`,
                    { stdio: 'inherit' }
                );
            }
            break;
        default:
            execSync(command, { stdio: 'inherit' });
    }
}

try {
    test();
} catch (error) {
    process.exit(error.status || 1);
}
