{
  "name": "@hgraca/lib-name",
  "version": "1.0.0",
  "license": "MIT",
  "description": "<lib-name-description>",
  "author": {
    "name": "Herberto Graça",
    "email": "herberto.graca@gmail.com"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "run": "ts-node src/index.ts",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:int": "jest --testPathPattern=tests/integration",
    "test:func": "jest --testPathPattern=tests/functional",
    "test:acc": "jest --testPathPattern=tests/acceptance",
    "test:coverage": "jest --coverage",
    "lint": "eslint 'src/**/*.ts' 'lib/**/*.ts' 'tests/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'lib/**/*.ts' 'tests/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts' 'lib/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'lib/**/*.ts' 'tests/**/*.ts'"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.52.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
